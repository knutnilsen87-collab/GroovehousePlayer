{
  "name": "groovehouse-vault",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "gh-ingest": "pnpm --filter @gv/ingest exec tsx src/cli.ts",
    "gh-watch": "pnpm --filter @gv/ingest exec tsx src/watch.ts",
    "dev": "pnpm --filter @gv/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "make-fixtures": "pnpm --filter @gv/ingest exec tsx src/make-fixtures.ts",
    "vault:server": "pnpm --filter @gv/server start",
    "vault:install": "pnpm --filter @gv/server vault install",
    "vault:uninstall": "pnpm --filter @gv/server vault uninstall",
    "vault:lan": "pnpm --filter @gv/server vault lan",
    "vault:remote": "pnpm --filter @gv/server vault remote",
    "android:build": "pnpm --filter @gv/server exec node --import tsx ../android/scripts/android.ts build",
    "android:install": "pnpm --filter @gv/server exec node --import tsx ../android/scripts/android.ts install",
    "eval:analysis": "pnpm --filter @gv/ingest exec tsx src/eval.ts",
    "ingest:bench": "pnpm --filter @gv/ingest exec tsx src/bench.ts",
    "android:release": "pnpm --filter @gv/server exec node --import tsx ../android/scripts/android.ts release",
    "vault:autostart": "pnpm --filter @gv/server vault autostart",
    "vault:backup": "node scripts/vault-backup.mjs",
    "vault:covers": "pnpm --filter @gv/ingest exec tsx src/cli.ts --vault-covers"
  }
}
