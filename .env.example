# Kopier til .env og fyll inn. .env skal ALDRI inn i git.

# Lokal ingest
GH_EXPORT_DIR=C:\Users\<deg>\Music\Groovehouse\Export
GH_MEDIA_DIR=./media

# Supabase (fase 2 – ikke i bruk i fase 1)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role-nøkkelen går forbi all RLS. Legg den i Windows Credential Manager, ikke her.

# Cloudflare R2 (fase 2)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# HMAC-hemmelighet for avspillingstokens (fase 2)
PLAY_TOKEN_SECRET=

# Del 13: lytterlenker. Tokenet kan også ligge i Credential Manager (listen-admin). Aldri i git.
# LISTEN_ADMIN_URL=https://listen.groovehouserecords.com
# LISTEN_ADMIN_TOKEN=
# LISTEN_ORIGIN=https://listen.groovehouserecords.com
